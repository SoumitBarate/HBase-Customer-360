# 6. INSERT CUSTOMER 5 - ROHAN VERMA
put 'customer_profiles', 'CUST1005', 'personal:name', 'Rohan Verma'
put 'customer_profiles', 'CUST1005', 'personal:city', 'Hyderabad'
put 'customer_profiles', 'CUST1005', 'personal:mobile', '9876543214'
put 'customer_profiles', 'CUST1005', 'service:plan', '5G Premium'
