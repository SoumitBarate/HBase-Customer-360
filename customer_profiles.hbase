put 'customer_profiles', 'CUST1005', 'usage:data_usage', '30GB'

# 7. RETRIEVE ONE CUSTOMER
get 'customer_profiles', 'CUST1001'

# 8. RETRIEVE MULTIPLE CUSTOMERS
scan 'customer_profiles'

# 9. RETRIEVE ONLY SPECIFIC COLUMN
get 'customer_profiles', 'CUST1001', {COLUMN => 'personal:name'}

# 10. UPDATE CUSTOMER CITY
put 'customer_profiles', 'CUST1001', 'personal:city', 'Mumbai'

# 11. UPDATE CUSTOMER PLAN
put 'customer_profiles', 'CUST1002', 'service:plan', '5G Gold'

# 12. DELETE ONE COLUMN
delete 'customer_profiles', 'CUST1003', 'personal:city'

# 13. COUNT TOTAL CUSTOMERS
count 'customer_profiles'

# 14. DISPLAY TABLE STRUCTURE
describe 'customer_profiles'

# 15. DISPLAY ALL TABLES
list

# 16. CHECK ONE CUSTOMER AFTER UPDATE
get 'customer_profiles', 'CUST1001'

# 17. DELETE ENTIRE CUSTOMER RECORD
deleteall 'customer_profiles', 'CUST1005'

# 18. COUNT CUSTOMERS AFTER DELETION
count 'customer_profiles'

# 19. DISABLE TABLE
disable 'customer_profiles'

# 20. DROP TABLE
drop 'customer_profiles'