put 'customer_profiles', 'CUST1003', 'personal:city', 'Delhi'
put 'customer_profiles', 'CUST1003', 'personal:mobile', '9876543212'
put 'customer_profiles', 'CUST1003', 'service:plan', '5G Basic'
put 'customer_profiles', 'CUST1003', 'service:status', 'Inactive'
put 'customer_profiles', 'CUST1003', 'usage:data_usage', '10GB'

